# Скопируй в ~/.config/study-agent/config.env и поправь под себя.
# Формат KEY=значение: файл читают и fish-скрипты, и python-скрипты.

# Корень вольта Obsidian.
SA_VAULT_DIR=~/Documents/Obsidian

# Папка внутри вольта, куда складываются учебные сессии.
SA_STUDY_SUBDIR=Обучение

# Как обращаться к тебе в промптах: «... задали вопрос».
SA_USER_NAME=участнику

# Язык распознавания для whisper (ru, en, de, ...).
# ВНИМАНИЕ: тексты промптов написаны по-русски и заметки выходят на русском.
# Для другого языка их нужно перевести — см. README.
SA_LANG=ru

SA_WHISPER_URL=http://127.0.0.1:8080/inference
SA_OLLAMA_URL=http://127.0.0.1:11434/api/generate
SA_CAPTURE_DEVICE=agent-capture.monitor
