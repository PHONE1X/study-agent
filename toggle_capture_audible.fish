#!/usr/bin/env fish
# Совместимость со старым именем: переключает "слышу / не слышу".
#
# Отличие от старой версии: раньше скрипт выгружал модуль петли целиком,
# теперь он просто глушит её. Результат для тебя тот же (звук пропадает),
# но объект остаётся на месте: его видно в pavucontrol, у него сохраняются
# громкость и устройство, и включается он обратно мгновенно.
set -l d (dirname (status --current-filename))
exec $d/agent.fish toggle
