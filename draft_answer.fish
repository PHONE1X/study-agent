#!/usr/bin/env fish
# Вызывается из hot_path_daemon.fish в фоне после срабатывания триггера.
#
# Делает четыре вещи:
#   1) ждёт немного, чтобы в транскрипт успел попасть ХВОСТ обращения;
#   2) просит модель разобрать, что именно у тебя спросили;
#   3) ищет ответ -- сначала в разговоре, потом в заметках прошлых сессий;
#   4) пишет запись в вольт (Обращения.md) и шлёт уведомление.
#
# ПОЧЕМУ ЖДЁМ. Обращение почти никогда не умещается в один чанк: имя звучит в
# начале фразы, а сам вопрос договаривается уже в следующие несколько секунд.
# Если строить ответ сразу по строке с именем, модель видит «ИМЯ, а вот...» и
# отвечает наугад. Пауза в один чанк ловит продолжение.
#
# УВЕДОМЛЕНИЕ ОДНО, А НЕ ДВА. Раньше hot_path_daemon.fish слал своё, мгновенное
# («К вам обратились»), а это -- второе, следом, с вопросом и ответом. Хотели
# как быстрее: первое уходило ещё до запуска этого скрипта. На практике же оба
# всплывали почти подряд по одному и тому же поводу и выглядели как повтор
# (жалоба живая, 2026-08-21), поэтому первое убрали. Плата за это честная:
# теперь до уведомления проходит вся пауза ниже плюс оба вызова модели, а не
# 0 секунд, как было для самого первого сигнала.
#
# ТИПЫ ОБРАЩЕНИЙ. Не всякое обращение -- вопрос по теме. «ИМЯ, ты тут?» это
# оклик, на него нужен короткий ответ, а не разбор контекста. А имя может
# прозвучать и в разговоре О тебе, без обращения К тебе. Поэтому модель сначала
# классифицирует обращение и только потом отвечает.
#
# ПОЧЕМУ ДВА ВЫЗОВА МОДЕЛИ, А НЕ ОДИН. Сначала разбор и ответ делались одним
# промптом. Когда туда добавились заметки и правила про источник, qwen3:8b
# перестал справляться: вопрос перестал восстанавливаться (в question уезжала
# строка с именем целиком) и источник помечался наугад. Разделение вернуло
# качество -- каждый вызов решает одну задачу, ценой суммарного времени обоих.
#
# ПОЧЕМУ ВАЖЕН ИСТОЧНИК. Черновик зачитывают вслух как свои слова. Выдуманный
# факт тут хуже, чем отсутствие ответа. Живой пример: на вопрос «как часто
# ротировать ключи по регламенту» модель уверенно ответила «раз в 90 дней» --
# этого не было ни в разговоре, ни в заметках. Теперь модель обязана назвать
# источник, а «нет в материалах» -- допустимый и честный ответ.

source (dirname (status --current-filename))/sa_config.fish
set -g OLLAMA_URL "http://127.0.0.1:11434/api/generate"
source (dirname (status --current-filename))/sa_common.fish
set -g SA_DIR_SELF (dirname (status --current-filename))
set -g MODEL (sa_model | string collect)
set -g DATA_DIR ~/.local/share/study-agent
set -g TRANSCRIPT_FILE $DATA_DIR/transcript.log
set -g ASKS_FILE $DATA_DIR/asks.jsonl
set -g COLD_STATE $DATA_DIR/cold_path_state.json
set -g STUDY_DIR $SA_STUDY_DIR

# Пауза перед разбором, в секундах. Окно транскрипции -- 30 секунд, но строка
# пишется по границе фразы, так что 5 обычно ловит договорённый вопрос.
# Ставь 0, если важнее скорость.
if not set -q STUDY_AGENT_ASK_DELAY
    set -g STUDY_AGENT_ASK_DELAY 5
end

if not set -q STUDY_AGENT_CONTEXT_LINES
    set -g STUDY_AGENT_CONTEXT_LINES 30
end

set -l trigger_text $argv[1]
set -l trigger_ts $argv[2]
# Третий аргумент -- режим. «группа» означает, что имя не звучало, а вопрос
# задан всей аудитории. Классификация «вопрос/оклик/упоминание» там не нужна:
# это заведомо вопрос, и разбирать надо только его формулировку.
set -l mode $argv[3]

if test -z "$trigger_text"
    echo "draft_answer.fish: no trigger text given" >&2
    exit 1
end
if test -z "$trigger_ts"
    set trigger_ts (date "+%H:%M:%S")
end

if test "$STUDY_AGENT_ASK_DELAY" -gt 0
    sleep $STUDY_AGENT_ASK_DELAY
end

function ollama_json --argument-names prompt
    # num_predict ограничивает разгон генерации. Черновик -- это 2-4 предложения,
    # и без потолка модель иногда уходила в рассуждения на полминуты. Здесь
    # важна скорость: ответ нужен, пока вопрос ещё висит в воздухе.
    set -l payload (jq -nc --arg model $MODEL --arg prompt "$prompt" --argjson ctx $SA_NUM_CTX \
        '{model: $model, prompt: $prompt, think: false, stream: false, format: "json", options: {num_ctx: $ctx, num_predict: 300}}')
    curl -s -m 60 -X POST $OLLAMA_URL -H "Content-Type: application/json" -d "$payload" \
        | jq -r '.response // empty' | string collect
end

# string collect обязателен: без него многострочный вывод режется на список и
# склеивается пробелами при обратной подстановке.
set -l context (tail -n $STUDY_AGENT_CONTEXT_LINES $TRANSCRIPT_FILE | string collect)

set -g session_dir ""
if test -f $COLD_STATE
    set session_dir (jq -r '.session_dir // empty' $COLD_STATE | string collect)
end

# --- вызов 1: что именно спросили ----------------------------------------

set -l classify_prompt "Ты помогаешь $SA_USER_NAME во время учебной конференции. Только что в разговоре прозвучало его имя.

Вот последние несколько минут транскрипта (распознавание речи, возможны ошибки):
$context

Строка, где прозвучало имя: \"$trigger_text\"

Разбери, что произошло, и верни JSON строго такого вида:
{
  \"type\": \"вопрос\" или \"оклик\" или \"упоминание\",
  \"question\": \"как именно сформулировано обращение, одной фразой\"
}

ГДЕ ИСКАТЬ САМ ВОПРОС. Имя и вопрос почти никогда не звучат вместе. Смотри в обе стороны от строки с именем:
- вопрос может идти ПОСЛЕ имени: «ИМЯ, а что там по срокам?»;
- вопрос может идти ДО имени, если сначала спросили в воздух, а потом выбрали, кому отвечать: «А как мы вообще решаем вопрос с лимитами?... ИМЯ, что скажешь?». Тогда вопрос — это «как решаем вопрос с лимитами», а не «что скажешь»;
- имя может стоять в середине: «А вот, ИМЯ, скажи, сколько это заняло по времени?».
Восстанови вопрос целиком по смыслу, а не копируй строку с именем дословно. В question не должно остаться слов «что скажешь», «ты же этим занимался» — это не вопрос, это передача слова.

ЧЕГО ДЕЛАТЬ НЕЛЬЗЯ. question — это то, что кто-то реально произнёс. Его надо найти в транскрипте, а не сочинить. Если в тексте выше нет фразы, которую можно показать пальцем и сказать «вот о чём спросили», — значит, вопроса не было, и это \"упоминание\" с пустым question. Пустой question — нормальный и правильный ответ. Придумать правдоподобный вопрос по теме занятия — грубая ошибка: $SA_USER_NAME получит ответ на то, чего у него никто не спрашивал.

ИМЯ КАК ПОДЛЕЖАЩЕЕ — ЭТО НЕ ОБРАЩЕНИЕ. Если про человека говорят в третьем лице («отвечал ИМЯ», «это вопрос ИМЯ», «ИМЯ уже настраивал», «сейчас ИМЯ покажет»), то к нему НЕ обращались, даже если рядом в строке стоит знак вопроса. Такой знак вопроса относится к чужому вопросу, а не к нему. Это всегда \"упоминание\".

Как выбирать type:
- \"вопрос\" — $SA_USER_NAME о чём-то спросили по существу;
- \"оклик\" — его просто позвали, проверяют на месте ли («ИМЯ, ты тут?», «ИМЯ?», «ИМЯ, слышно меня?»);
- \"упоминание\" — имя прозвучало в разговоре О нём, а не в обращении К нему («ИМЯ это уже настраивал»)."

if test "$mode" = "группа"
    set classify_prompt "На обучении прозвучал вопрос, обращённый ко всем участникам сразу.

Вот последние несколько минут транскрипта (распознавание речи, возможны ошибки):
$context

Строка с вопросом: \"$trigger_text\"

Верни JSON строго такого вида:
{
  \"type\": \"вопрос\",
  \"question\": \"сам вопрос, одной фразой\"
}

Сформулируй вопрос так, как его понял бы участник: без обращения к аудитории («ребят», «коллеги») и без слов-связок. Если в строке несколько вопросов подряд, возьми тот, на который ждут ответа."
end

set -l parsed (ollama_json "$classify_prompt")
set -l ask_type (echo "$parsed" | jq -r '.type // empty' 2>/dev/null | string trim | string collect)
set -l question (echo "$parsed" | jq -r '.question // empty' 2>/dev/null | string trim | string collect)

# Гвард длины. Живой прогон 2026-08-20 показал: модель иногда вместо
# восстановленного вопроса возвращает в question целый абзац транскрипта
# дословно (нарушая собственную инструкцию промпта). Такой «вопрос» в
# уведомлении нечитаем и превращает черновик ответа в разбор каши. Настоящий
# восстановленный вопрос -- это одна фраза, длинная по-русски редко превышает
# ~120 символов. Если модель вернула заведомо больше и внутри есть «?» --
# берём только текст до первого «?» включительно (это и есть сам вопрос,
# остальное -- рассуждение по инерции). Если «?» нет вовсе -- это не вопрос,
# а мусор форматирования, и лучше промолчать, чем показать абзац.
if test (string length -- "$question") -gt 120
    if string match -q -r -- '\?' -- "$question"
        set question (string match -r -- '^.*?\?' "$question" | string collect)
        echo "DRAFT: вопрос был длиннее 120 символов, обрезал до первого «?»: $question" >&2
    else
        echo "DRAFT: модель вернула вместо вопроса абзац без «?» ($(string length -- "$question") симв.) -- отбрасываю" >&2
        set question ""
    end
end

# Если модель не ответила или вернула не то -- запись всё равно должна остаться.
# Потерять факт обращения хуже, чем остаться без черновика.
if test -z "$ask_type"
    set ask_type "вопрос"
end
if test "$mode" = "группа"
    set ask_type "вопрос"
end
if test -z "$question"
    if test "$mode" = "группа"
        # Вопрос ко всем: сама строка и есть вопрос, восстанавливать нечего.
        set question "$trigger_text"
    else
        # Пустой question при «вопросе» значит, что модель не нашла, что
        # именно спросили. Раньше сюда подставлялась строка с именем, и дальше
        # вызов 2 честно сочинял ответ на несуществующий вопрос. Молчание
        # лучше: имя всё равно уже показано в первом уведомлении.
        set ask_type "упоминание"
    end
end

# --- вызов 2: ответ, и обязательно с источником ---------------------------

set -l answer ""
set -l source ""

switch $ask_type
    case упоминание
        # Отвечать не на что: говорили о нём, а не с ним.
    case оклик
        set answer "Да, я здесь."
        set source "оклик"
    case '*'
        set ask_type "вопрос"
        # Ответ может лежать в заметках ПРОШЛЫХ сессий: спросили на седьмом
        # дне курса, а разбирали на втором. Ищем по восстановленному вопросу --
        # строка с именем для поиска бесполезна, в ней нет значимых слов.
        set -l notes (python3 $SA_DIR_SELF/find_in_notes.py "$question" "$session_dir" | string collect)
        if test -z "$notes"
            set notes "(ничего похожего в заметках не нашлось)"
        end

        set -l answer_prompt "$SA_USER_NAME задали вопрос на совещании. Составь черновик ответа.

Вопрос: \"$question\"

Что говорили в разговоре последние минуты (распознавание речи, возможны ошибки):
$context

Что нашлось в заметках прошлых занятий:
$notes

Верни JSON строго такого вида:
{
  \"answer\": \"черновик ответа, 2-4 предложения, без вступлений\",
  \"source\": \"разговор\" или \"заметки\" или \"нет\"
}

ОТКУДА БРАТЬ ОТВЕТ. Это самое важное. Черновик зачитают вслух как слова $SA_USER_NAME, поэтому выдуманный факт хуже, чем отсутствие ответа.
- ответ прозвучал в разговоре — отвечай по нему, source = \"разговор\";
- в разговоре ответа нет, но он есть в заметках — отвечай по ним, source = \"заметки\";
- ответа нет нигде — source = \"нет\", а в answer короткая честная реплика, которую человек может произнести вслух, чтобы не молчать. НЕ заполняй пустоту правдоподобным фактом.

НИКОГДА не называй числа, сроки, периодичность, версии, названия и имена, которых нет ни в разговоре, ни в заметках. Если конкретная цифра не прозвучала — её нет, и подставлять похожую нельзя. Общие рассуждения о том, «от чего это зависит», — это тоже не ответ: если сути не прозвучало, source = \"нет\".

ЕСЛИ ОТВЕТ НАШЁЛСЯ — приведи конкретику дословно. Спросили «как часто» — назови срок из материалов, а не «по регламенту». Спросили «кто отвечает» — назови того, кто там указан. Ответ без цифры, которая есть в материалах, считается неполным.

НЕ ПРИПИСЫВАЙ РОЛИ. Не пиши «отвечаю я», «это делаю я», «это моя зона», если в материалах не сказано, что это $SA_USER_NAME. Кто за что отвечает — бери только из текста.

Если вопрос не по теме занятия (о погоде, о личном, о планах) — отвечай по смыслу самого вопроса и не притягивай контекст лекции; source = \"нет\".

НЕ ПЕРЕПИСЫВАЙ ВОПРОС В ОТВЕТ. Ответ — это то, что скажет человек, когда его спросили. Копировать строку из транскрипта нельзя: это не ответ, а то, что уже прозвучало.

ВОПРОСЫ ПРО МНЕНИЕ. Если спрашивают мнение, ощущение, опыт, настроение или согласие («удобно ли», «как вам», «что думаете», «как настроение») — фактического ответа не существует нигде, и искать его в материалах не надо. Дай короткую живую реплику в первом лице, одну-две фразы, которую можно произнести вслух как есть, и поставь source = \"нет\"."

        set -l ans_parsed (ollama_json "$answer_prompt")
        set answer (echo "$ans_parsed" | jq -r '.answer // empty' 2>/dev/null | string trim | string collect)
        set source (echo "$ans_parsed" | jq -r '.source // empty' 2>/dev/null | string trim | string collect)
        if test -z "$answer"
            set answer "(модель не ответила — смотри транскрипт)"
            set source "нет"
        end

        # Модель сама признала, что источника нет, -- и тут же назвала время
        # «с 9 до 18», которого никто не произносил. Запрет на выдуманные
        # числа в промпте есть, но промпт -- это просьба, а не гарантия.
        # Здесь проверка детерминированная: при source=нет в черновике не
        # должно быть ни одной цифры. Черновик зачитывают вслух как свои
        # слова, поэтому «не знаю» безопаснее правдоподобной цифры.
        if test "$source" = "нет"; and string match -q -r -- '[0-9]' "$answer"
            echo "DRAFT: убрал выдуманную конкретику из ответа без источника: $answer" >&2
            set answer "Сходу не скажу — надо уточнить."
        end
end

# Откуда взят ответ -- это то, по чему решают, можно ли его произносить вслух.
# Поэтому пометка идёт и в уведомление, и в заметку, а не только в лог.
# Вопрос про мнение фактического ответа не имеет в принципе, и помечать такую
# реплику как «по разговору» -- врать про её надёжность. Модель эту разницу
# держит плохо (просили source=нет, она всё равно ставит «разговор»), поэтому
# решаем по самому вопросу, а не по ответу модели.
if test "$ask_type" = "вопрос"
    if string match -q -r -- "удобн|как вам|как ваше|как у вас|что думает|как думает|как считает|согласн|нравит|настроени|как себя чувств|готовы ли|всем ли понятн|всё ли понятн" (string lower -- "$question")
        set source "мнение"
    end
end

set -l source_label ""
switch "$source"
    case мнение
        set source_label "личная реплика — не факт из материалов"
    case разговор
        set source_label "по разговору"
    case заметки
        set source_label "по заметкам прошлых занятий"
    case нет
        set source_label "ОТВЕТА НЕТ В МАТЕРИАЛАХ"
    case оклик
        set source_label ""
    case '*'
        set source_label "источник не указан — проверь"
end

# -t 20000 -- держать 20 секунд вместо дефолтных 7 (Quickshell, а не dunst,
# см. историю в hot_path_daemon.fish). Сначала стояло -t 0 ("вечно"), но в
# этом шелле -t 0 означает "таймер вообще не создаётся", а единственное, что
# тогда снимает попап -- обработчик наведения мыши в NotificationGroup.qml:
# при УХОДЕ курсора с уведомления он принудительно закрывает его немедленно.
# Без таймера получалось "висит, пока не подведёшь и не уведёшь мышку" --
# неочевидно и жалоба живая (2026-08-21). Пробовали 45 с -- тоже жалоба, что
# долго висит. Конечный таймер работает с обработчиком наведения штатно
# (наведение просто ставит его на паузу) и всё равно закрывается сам, а не
# от жеста мышью.
switch $ask_type
    case оклик
        notify-send -u critical -t 20000 "Тебя позвали" "$question

$answer"
    case упоминание
        notify-send -u normal -t 20000 "Упоминание имени" "$question"
    case '*'
        set -l title "Вопрос к тебе"
        if test "$mode" = "группа"
            set title "Вопрос ко всем"
        end
        notify-send -u critical -t 20000 "$title" "$question

$answer

($source_label)"
end

echo "ASK [$ask_type] $question"
if test -n "$answer"
    echo "DRAFT [$source] $answer"
end

# --- запись в журнал обращений -------------------------------------------

mkdir -p $DATA_DIR

jq -nc --arg ts "$trigger_ts" --arg type "$ask_type" --arg q "$question" \
    --arg a "$answer" --arg raw "$trigger_text" --arg sess "$session_dir" \
    --arg src "$source" \
    '{ts: $ts, type: $type, question: $q, answer: $a, source: $src, raw: $raw, session: $sess}' \
    >> $ASKS_FILE

# Запись в вольт -- сразу, а не в конце сессии: смысл журнала в том, чтобы
# открыть его прямо во время разговора и увидеть, что именно спросили.
if test -n "$session_dir" -a -d "$STUDY_DIR/$session_dir"
    set -l asks_md "$STUDY_DIR/$session_dir/Обращения.md"
    if not test -f "$asks_md"
        echo "# Обращения к тебе

Заполняется в реальном времени, в момент обращения.
" > "$asks_md"
        # Ссылку в Обзор ставим только сейчас, когда файл реально появился,
        # иначе в вольте болталась бы висячая ссылка всю сессию.
        set -l overview "$STUDY_DIR/$session_dir/Обзор.md"
        if test -f "$overview"
            if not grep -q '\[\[Обращения\]\]' "$overview"
                set -l tmp "$overview.tmp"
                begin
                    head -n1 "$overview"
                    echo ""
                    echo "**[[Обращения]]** — что и когда спрашивали лично тебя."
                    tail -n +2 "$overview"
                end > $tmp; and mv $tmp "$overview"
            end
        end
    end
    begin
        echo ""
        switch $ask_type
            case оклик
                echo "## $trigger_ts — оклик"
            case упоминание
                echo "## $trigger_ts — упоминание"
            case '*'
                if test "$mode" = "группа"
                    echo "## $trigger_ts — вопрос ко всем"
                else
                    echo "## $trigger_ts — вопрос"
                end
        end
        echo ""
        echo "> $question"
        echo ""
        if test -n "$answer"
            echo "**Черновик ответа:** $answer"
            echo ""
            if test "$source" = "нет"
                echo "> [!warning] Ответа нет ни в разговоре, ни в заметках"
                echo "> Реплика выше — способ не молчать, а не ответ по существу."
                echo ""
            else if test -n "$source_label"
                echo "*Источник ответа:* $source_label"
                echo ""
            end
        end
        echo "*Прозвучало так:* $trigger_text"
    end >> "$asks_md"
end
