#!/usr/bin/env fish
# Синтез связного описания для ЗАКРЫТОГО сегмента заметок.
#
# ЗАЧЕМ. cold_path_daemon пишет заметки по кускам транскрипта (примерно раз
# в 2-4 минуты), по пункту на факт -- это нужно, чтобы конспект рос на глазах
# во время занятия. Но когда тема закрывается, в файле остаётся плоский
# хронологический список из десятков разрозненных пунктов без единого связного
# описания того, что это вообще такое. Живой пример 2026-08-20: файл
# «24 Стартовый тариф.md» не отвечает на вопрос «что такое стартовый тариф»,
# хотя все нужные факты в нём уже есть -- они просто не собраны вместе.
#
# Вызывается ПОСЛЕ того, как сегмент закрыт (тема сменилась), в фоне, не
# блокируя цикл заметок. Источник фактов -- уже написанные пункты этого же
# файла, а не сырой транскрипт: они уже прошли проверку на выдумку в
# ground_bullets.py, значит безопасны как основа для пересказа, и это на
# порядок дешевле по контексту, чем весь фрагмент транскрипта заново.
#
# ИДЕМПОТЕНТНОСТЬ. Если в файле уже есть «## Кратко», выходим сразу -- иначе
# повторный запуск (например, при повторном прогоне бэкафилла) задвоил бы
# синтез.
#
# ИСПОЛЬЗОВАНИЕ
#   finalize_segment.fish <путь-к-файлу-сегмента> <название-сегмента> <название-курса>

source (dirname (status --current-filename))/sa_config.fish
set -g OLLAMA_URL "http://127.0.0.1:11434/api/generate"
source (dirname (status --current-filename))/sa_common.fish
set -g MODEL (sa_model | string collect)

set -l file $argv[1]
set -l seg_title $argv[2]
set -l course_title $argv[3]

if test -z "$file" -o -z "$seg_title"
    echo "finalize_segment.fish: нужен путь к файлу и название сегмента" >&2
    exit 1
end
if not test -s "$file"
    exit 0
end
if grep -q '^## Кратко' "$file"
    exit 0
end

set -l split_line (grep -n '^### ' "$file" | head -n1 | cut -d: -f1 | string trim | string collect)
if test -z "$split_line"
    # Ни одного блока с пунктами -- сегмент пуст или ещё не дописан, нечего сворачивать.
    exit 0
end

set -l header (sed -n "1,"(math $split_line - 1)"p" "$file" | string collect)
set -l chronology (sed -n "$split_line,\$p" "$file" | string collect)

function list_bullets --argument-names text
    for l in (string split \n -- $text)
        if string match -qr '^-\s' -- $l
            echo $l
        end
    end
end

set -l bullets (list_bullets "$chronology" | string collect)
if test -z (string trim -- "$bullets" | string collect)
    exit 0
end

set -l prompt "Тема раздела конспекта: «$seg_title» (курс: «$course_title»).

Ниже -- пункты, которые уже записаны в заметках по ходу этой темы, в хронологическом порядке. Каждый пункт уже проверен и опирается на реально сказанное.

$bullets

Собери из этих пунктов связное описание темы для человека, который откроет заметку позже и не был на занятии. 4-8 предложений, или короткие подзаголовки со списком, если тема явно распадается на несколько частей (например, разные тарифы или разные условия).

Требования:
- используй ТОЛЬКО факты из пунктов выше, ничего не добавляй от себя и не обобщай сверх того, что там написано;
- если в пунктах есть противоречащие друг другу цифры или условия (например, разные цены для разных случаев) -- сохрани оба варианта с пояснением, при каком условии верен каждый, а не выбирай один произвольно и не усредняй их;
- пункты, которые не по сути темы, а организационная реплика или число без контекста -- пропусти, если такие попались;
- пиши как связный текст для чтения, а не как ещё один список фактов через запятую;
- без вступления вида «в этом разделе» и без заключения -- сразу по делу."

set -l synth (curl -s -m 120 -X POST $OLLAMA_URL -H "Content-Type: application/json" \
    -d (jq -nc --arg model $MODEL --arg prompt "$prompt" --argjson ctx $SA_NUM_CTX \
        '{model: $model, prompt: $prompt, think: false, stream: false, options: {num_ctx: $ctx, num_predict: 700}}') \
    | jq -r '.response // empty' | string trim | string collect)

# Тот же принцип, что и в основном цикле: пустой или подозрительно короткий
# ответ -- не результат, а сбой модели. Лучше оставить сегмент как есть (плоский
# список всё ещё читаем, просто неудобен), чем вписать в заметку пустоту.
if test -z "$synth" -o (string length -- "$synth") -lt 30
    echo "COLD PATH: синтез для «$seg_title» не удался (пустой или слишком короткий ответ) -- сегмент оставлен как есть" >&2
    exit 0
end

# Бэкап перед правкой заметки вольта -- если синтез окажется хуже исходных
# пунктов, можно вручную вернуться к сырому списку.
cp "$file" "$file.bak-"(date "+%Y%m%d-%H%M%S")

set -l tmp (mktemp -t study-agent-finalize.XXXXXX)
begin
    # printf %s\n на $header не гарантирует хвостовой пустой строки -- fish
    # обрезает завершающие пустые строки при захвате через string collect,
    # поэтому пустая строка перед заголовком добавляется отдельно и явно.
    printf '%s\n' "$header"
    echo ""
    echo "## Кратко"
    echo ""
    echo "$synth"
    echo ""
    echo "## Хронология"
    echo ""
    printf '%s\n' "$chronology"
end > $tmp

# cat в существующий файл, а НЕ mv временного файла поверх него. mv меняет
# inode: 1) права temp-файла (mktemp даёт 600, «только владелец») переезжают
# на заметку вместо её обычных 644 -- ровно так 31 файл в вольте 2026-08-20
# внезапно стал недоступен на чтение никому, кроме процесса-владельца;
# 2) смена inode на лету может сбить файловый watcher Obsidian, который следит
# за конкретным файлом, а не только за путём -- после серии таких подмен
# вольт переставал показывать новые изменения вовсе, хотя на диске всё было
# верно. cat пишет В СУЩЕСТВУЮЩИЙ файл, права и inode не трогает.
cat $tmp > "$file"
rm -f $tmp

echo "COLD PATH: сегмент «$seg_title» свёрнут в связное описание"
