[Unit]
Description=study-agent hot path (trigger detection on live transcript)
After=study-agent-transcribe.service
Requires=study-agent-transcribe.service

[Service]
Type=simple
ExecStart=%h/.local/bin/study-agent/hot_path_daemon.fish
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
